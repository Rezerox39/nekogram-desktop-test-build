@@ -15,7 +15,9 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 #include "data/data_session.h"
 #include "history/history_item.h"
 #include "lang/translate_mtproto_provider.h"
+#include "lang/translate_nekogram_provider.h"
 #include "lang/translate_url_provider.h"
+#include "neko/neko_config.h"
 #include "platform/platform_translate_provider.h"
 
 namespace {
@@ -33,15 +35,24 @@ namespace Ui {
 
 std::unique_ptr<TranslateProvider> CreateTranslateProvider(
 		not_null<Main::Session*> session) {
+	// 1. Explicit URL template takes priority (stock behaviour).
 	const auto urlTemplate = OptionTranslateUrlTemplate.value();
 	if (!urlTemplate.isEmpty()
 		&& urlTemplate.contains(u"%q"_q)) {
 		return CreateUrlTranslateProvider(urlTemplate);
 	}
+	// 2. Platform translation (CrowTranslate on Linux, etc.).
 	if (Core::App().settings().usePlatformTranslation()
 		&& Platform::IsTranslateProviderAvailable()) {
 		return Platform::CreateTranslateProvider();
 	}
+	// 3. Nekogram external provider (Google / DeepL).
+	//    Bypasses Premium-gated MTProto translation entirely.
+	const auto nekoType = Neko::translateProviderType();
+	if (nekoType != Neko::TranslateProviderType::Telegram) {
+		return CreateNekoTranslateProvider();
+	}
+	// 4. Fallback: Telegram MTProto (requires Premium on server side).
 	return CreateMTProtoTranslateProvider(session);
 }
 
